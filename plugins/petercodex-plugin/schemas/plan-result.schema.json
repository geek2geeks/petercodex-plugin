{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PeterCodex Plan Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "assumptions",
    "steps",
    "validation",
    "risks",
    "ready_to_execute"
  ],
  "properties": {
    "summary": { "type": "string", "minLength": 1 },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "files", "checks"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "files": {
            "type": "array",
            "items": { "type": "string" }
          },
          "checks": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ready_to_execute": { "type": "boolean" }
  }
}
